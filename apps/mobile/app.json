{
  "expo": {
    "name": "Body Finder – RuView",
    "slug": "body-finder-ruview",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "android": {
      "package": "com.trochez.bodyfinderruview",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.RANGING"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.trochez.bodyfinderruview",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Body Finder discovers nearby sensing nodes on the local field network.",
        "NSBluetoothAlwaysUsageDescription": "Body Finder uses Bluetooth ranging evidence to estimate relative sensor geometry when available."
      }
    },
    "plugins": [],
    "extra": {"truthMode":"experimental-auto-geometry","protocolVersion":2}
  }
}
